-- ── OPEN / CLOSE ───────────────────────────────────────────────────────────
local isOpen    = false
local animating = false

local function OpenUI(opts)
    if animating or isOpen then return end
    animating = true; isOpen = true
    opts = opts or {}
    local springDur = opts.springDur or .8
    local sideDelay = opts.sideDelay or .25
    local isInject  = opts.injectionFade ~= nil

    Main.Visible = true
    Main.Rotation = -3
    Main.Position = UDim2.new(.5, 0, .5, 45)
    Main.Size = UDim2.fromOffset(SW, SH)  -- set instantly, skip size tween during intro (frame saver)

    for _, entry in ipairs(sideTabOrder) do
        entry.btn.BackgroundTransparency = 1
        entry.lbl.TextTransparency = 1
        entry.icon.TextTransparency = 1
    end
    Indicator.BackgroundTransparency = 1

    -- injection curtain
    local curtain
    if isInject then
        curtain = Instance.new("Frame")
        curtain.Name = "FadeCurtain"
        curtain.Size = UDim2.new(1, 0, 1, 0)
        curtain.Position = UDim2.new(0, 0, 0, 0)
        curtain.BackgroundColor3 = Color3.new(0, 0, 0)
        curtain.BackgroundTransparency = 0
        curtain.BorderSizePixel = 0
        curtain.ZIndex = 999
        curtain.Parent = Main
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 16)
        c.Parent = curtain
    end

    -- only 2 tweens on Main — much smoother
    Tween(Main, {Rotation = 0}, springDur, Enum.EasingStyle.Back)
    Tween(Main, {Position = UDim2.new(.5, 0, .5, 0)}, springDur, Enum.EasingStyle.Back)

    if not opts.skipBackdrop then BackdropSet(true, isInject and 1.6 or .45) end

    -- sidebar reveal — wider spacing, less concurrency
    for i, entry in ipairs(sideTabOrder) do
        Delay(sideDelay + i*.09, function()
            Tween(entry.btn,  {BackgroundTransparency = 0}, .35, Enum.EasingStyle.Quint)
            Tween(entry.lbl,  {TextTransparency = 0},       .35, Enum.EasingStyle.Quint)
            Tween(entry.icon, {TextTransparency = 0},       .35, Enum.EasingStyle.Quint)
        end)
    end

    Delay(sideDelay + .4, function()
        local e = tabMap[currentTab] and tabMap[currentTab].entry
        if e then
            Indicator.BackgroundTransparency = 0
            Indicator.Position = UDim2.new(0, 0, 0, e.y)
            Indicator.Size = UDim2.new(0, 3, 0, SIDE_TAB_H)
        end
    end)

    -- two-stage cinematic curtain dissolve
    if curtain then
        Wait(.35)
        -- phase 1: quick dissolve removes ~72% of darkness
        local tw1 = TweenService:Create(curtain,
            TweenInfo.new(.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {BackgroundTransparency = .72})
        tw1:Play()
        tw1.Completed:Connect(function()
            -- phase 2: slow, buttery finish
            local tw2 = TweenService:Create(curtain,
                TweenInfo.new(1.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
                {BackgroundTransparency = 1})
            tw2:Play()
            tw2.Completed:Connect(function()
                pcall(function() if curtain and curtain.Parent then curtain:Destroy() end end)
            end)
        end)
    end

    Wait(springDur + .25)
    animating = false
end

local function CloseUI()
    if animating or not isOpen then return end
    animating = true; isOpen = false
    if previewOpen then HidePreview() end

    for i = #sideTabOrder, 1, -1 do
        local e = sideTabOrder[i]
        Delay((#sideTabOrder - i)*.03, function()
            Tween(e.lbl, {TextTransparency = 1}, .18)
            Tween(e.icon, {TextTransparency = 1}, .18)
        end)
    end
    Delay(.1, function()
        BackdropSet(false, .46)
    end)
    Tween(Main, {Rotation = -7}, .44, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    Tween(Main, {Position = UDim2.new(.5, 0, .5, 80)}, .44, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    Tween(Main, {Size = UDim2.fromOffset(SW*.84, SH*.84)}, .44, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    Wait(.5); Main.Visible = false; animating = false
end

local function ToggleUI() if isOpen then CloseUI() else OpenUI() end end

-- ── PARALLAX TILT ──────────────────────────────────────────────────────────
local tiltX,tiltY = 0,0
if _G.PerfTiltConn then _G.PerfTiltConn:Disconnect() end
_G.PerfTiltConn = RunService.RenderStepped:Connect(function()
    if not isOpen or animating or dragging then return end
    local cam = Workspace.CurrentCamera; if not cam then return end
    local vp  = cam.ViewportSize
    local mp  = UserInputService:GetMouseLocation()
    local rx  = (mp.X/vp.X - 0.5)*2
    local ry  = (mp.Y/vp.Y - 0.5)*2
    local tx  = rx*.28 - ry*.12
    local ty  = ry*.10
    tiltX = tiltX + (tx-tiltX)*.07
    tiltY = tiltY + (ty-tiltY)*.07
    Main.Rotation = tiltX
    Shadow.Position = UDim2.new(.5, tiltX*4, .5, 18+tiltY*6)
    GlowImg.Position= UDim2.new(.5, tiltX*2, .5, tiltY*3)
end)

