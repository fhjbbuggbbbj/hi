    local wW = PrevWorld.AbsoluteSize.X
    if wW<10 then wW=ContentW-20 end

    local cols  = math.min(#list,3)
    local slotW = wW/(cols+1)

    for i, p in ipairs(list) do
        local col = ((i-1)%cols)+1
        local row = math.floor((i-1)/cols)
        local x   = slotW*col - 40
        local y   = 18 + row*130

        local fig = Frm(PrevWorld,UDim2.fromOffset(80,112),UDim2.new(0,x,0,y+14),Color3.new(1,1,1),103)
