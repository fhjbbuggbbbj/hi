local function MkToggle(par, lbl, yp, def, cb)
    local r = Frm(par, UDim2.new(1,-PAD*2,0,ROW_H), UDim2.new(0,PAD,0,yp), T.BG, 6)
    r.BackgroundTransparency = 1
    Lbl(r, lbl, UDim2.new(1,-50,1,0), UDim2.new(0,0,0,0), T.Text, FS, 7)

    local TRK_W = 36; local TRK_H = isMobile and 17 or 19
    local KSZ   = TRK_H - 4

    local glow = Instance.new("ImageLabel")
    glow.AnchorPoint            = Vector2.new(.5,.5)
    glow.BackgroundTransparency = 1
    glow.Position               = UDim2.new(1,-TRK_W/2-3,0.5,0)
    glow.Size                   = UDim2.new(0,TRK_W+22,0,TRK_H+22)
    glow.Image                  = "rbxassetid://5028857084"
    glow.ImageColor3            = T.ToggleOn
    glow.ImageTransparency      = def and .52 or 1
    glow.ZIndex                 = 6
    glow.Parent                 = r

    local track = Frm(r, UDim2.new(0,TRK_W,0,TRK_H),
        UDim2.new(1,-TRK_W-4,0.5,-TRK_H/2),
        def and T.ToggleOn or T.ToggleOff, 7)
    RC(track, TRK_H)
    local trackStroke = Stroke(track, def and T.ToggleOn or T.Border, 1)

    local knob = Frm(track, UDim2.new(0,KSZ,0,KSZ),
        UDim2.new(0, def and (TRK_W-KSZ-2) or 2, 0.5,-KSZ/2), T.Knob, 8)
    RC(knob, KSZ)

    local state = def
    local function setState(s, anim)
        state = s
        if anim then
            Tween(track,{BackgroundColor3=s and T.ToggleOn or T.ToggleOff},.2,Enum.EasingStyle.Quart)
            Tween(knob, {Position=UDim2.new(0,s and (TRK_W-KSZ-2) or 2,0.5,-KSZ/2)},.28,Enum.EasingStyle.Back)
            Tween(glow, {ImageTransparency=s and .52 or 1},.22)
            trackStroke.Color = s and T.ToggleOn or T.Border
        else
            track.BackgroundColor3 = s and T.ToggleOn or T.ToggleOff
            knob.Position          = UDim2.new(0,s and (TRK_W-KSZ-2) or 2,0.5,-KSZ/2)
            trackStroke.Color      = s and T.ToggleOn or T.Border
            glow.ImageTransparency = s and .52 or 1
        end
    end
    setState(def, false)

    table.insert(AllToggles,{track=track,stroke=trackStroke,glow=glow,knob=knob,getState=function() return state end})

    track.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then
            setState(not state, true)
            if cb then cb(state) end
            Ripple(track, i.Position, T.ToggleOn)
        end
    end)
end

local function MkSlider(par, lbl, yp, mn, mx, def, cb)
    local r = Frm(par, UDim2.new(1,-PAD*2,0,SLD_H), UDim2.new(0,PAD,0,yp), T.BG, 6)
    r.BackgroundTransparency = 1
    Lbl(r, lbl, UDim2.new(1,-52,0,isMobile and 2 or 3), UDim2.new(0,0,0,0), T.Text, FS, 7)
    local vLbl = Lbl(r, tostring(def),
        UDim2.new(0,48,0,isMobile and 2 or 3), UDim2.new(1,-50,0,0),
        T.Accent, FS, 7, true, Enum.TextXAlignment.Right)
    RegisterThemed(function() vLbl.TextColor3=T.Accent end)

    local TRK_H = isMobile and 5 or 6
    local trk = Frm(r, UDim2.new(1,0,0,TRK_H), UDim2.new(0,0,0,isMobile and 22 or 26), T.ToggleOff, 7)
    RC(trk, 4)
    local pct  = (def-mn)/(mx-mn)
    local fill = Frm(trk, UDim2.new(pct,0,1,0), UDim2.new(0,0,0,0), T.Accent, 8)
    RC(fill, 4)
    local fillGrad = Instance.new("UIGradient")
    fillGrad.Color  = ColorSequence.new({
        ColorSequenceKeypoint.new(0, T.Accent),
        ColorSequenceKeypoint.new(1, T.AccentGlow),
    })
    fillGrad.Parent = fill

    local KSZ  = isMobile and 13 or 15
    local knob = Frm(trk, UDim2.new(0,KSZ,0,KSZ), UDim2.new(pct,-KSZ/2,0.5,-KSZ/2), T.AccentGlow, 9)
    RC(knob, KSZ)
    local knobGlow = Instance.new("ImageLabel")
    knobGlow.AnchorPoint            = Vector2.new(.5,.5)
    knobGlow.BackgroundTransparency = 1
    knobGlow.Position               = UDim2.new(.5,0,.5,0)
    knobGlow.Size                   = UDim2.new(2.8,0,2.8,0)
    knobGlow.Image                  = "rbxassetid://5028857084"
    knobGlow.ImageColor3            = T.AccentGlow
    knobGlow.ImageTransparency      = .52
    knobGlow.ZIndex                 = 8
    knobGlow.Parent                 = knob

    table.insert(AllSliders,{fill=fill,fillGrad=fillGrad,knob=knob,knobGlow=knobGlow})

    local sliding = false; local lastVal = def
    local function upd(pos)
        local rel = math.clamp((pos.X - trk.AbsolutePosition.X)/trk.AbsoluteSize.X,0,1)
        local val = math.round(mn + rel*(mx-mn))
        vLbl.Text = tostring(val)
        Tween(fill,{Size=UDim2.new(rel,0,1,0)},.04)
        Tween(knob,{Position=UDim2.new(rel,-KSZ/2,0.5,-KSZ/2)},.04)
        if val ~= lastVal then
            vLbl.TextSize=FS+2
            Tween(vLbl,{TextSize=FS},.18,Enum.EasingStyle.Back)
            lastVal=val
        end
        if cb then cb(val) end
    end
    trk.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then sliding=true; upd(i.Position) end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and (i.UserInputType==Enum.UserInputType.MouseMovement
        or i.UserInputType==Enum.UserInputType.Touch) then upd(i.Position) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then sliding=false end
    end)
end

