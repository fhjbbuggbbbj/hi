local COLOR_PRESETS = {
    {n="Crimson",    c=Color3.fromRGB(220,40,60)},
    {n="Neon Red",   c=Color3.fromRGB(255,28,56)},
    {n="Orange",     c=Color3.fromRGB(255,128,20)},
