local function BuildPreview()
    ClearPreviewFigs()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer then table.insert(list,p) end
        if #list>=4 then break end
    end
    if #list==0 then PrevStatus.Text="no other players"; return end
