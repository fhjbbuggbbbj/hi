    Tween(prog,{Size=UDim2.new(0,0,0,2)},2.4,Enum.EasingStyle.Linear)
    Lbl(card, title, UDim2.new(1,-26,0,18), UDim2.new(0,20,0,9),  T.Text,    13, 52, true)
    Lbl(card, msg,   UDim2.new(1,-26,0,16), UDim2.new(0,20,0,30), T.TextDim, 10, 52)
    local slotY = toastStack * 62; toastStack = toastStack + 1
    Tween(card,{Position=UDim2.new(1,0,0,slotY)},.34,Enum.EasingStyle.Back)
    Delay(2.8, function()
        Tween(card,{Position=UDim2.new(1,65,0,slotY)},.26,Enum.EasingStyle.Quad,Enum.EasingDirection.In)
        Tween(card,{BackgroundTransparency=1},.26); Tween(cs,{Transparency=1},.26)
        Wait(.3); card:Destroy(); toastStack = math.max(0, toastStack-1)
    end)
end

