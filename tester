-- ── HELPERS ────────────────────────────────────────────────────────────────
local function Tween(o, p, t, style, dir)
    local tw = TweenService:Create(
        o,
        TweenInfo.new(t or .16, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        p)
    tw:Play(); return tw
end

local function RC(o, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 6); c.Parent = o; return c
end

local function Stroke(o, col, th)
    local s = Instance.new("UIStroke")
    s.Color           = col or T.Border
    s.Thickness       = th  or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = o; return s
end

local function Frm(par, sz, pos, col, zi)
    local f = Instance.new("Frame")
    f.Size = sz; f.Position = pos
    f.BackgroundColor3 = col or T.Panel
    f.BorderSizePixel = 0; f.ZIndex = zi or 2; f.Parent = par
    return f
end

local function Lbl(par, txt, sz, pos, col, fs, zi, bold, align)
    local l = Instance.new("TextLabel")
    l.Size = sz; l.Position = pos; l.BackgroundTransparency = 1
    l.Text = txt; l.TextColor3 = col or T.Text
    l.TextSize = fs or FS; l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    l.ZIndex = zi or 3; l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Parent = par; return l
end

local function Btn(par, sz, pos, col, zi)
    local b = Instance.new("TextButton")
    b.Size = sz; b.Position = pos; b.BackgroundColor3 = col or T.Panel
    b.BorderSizePixel = 0; b.Text = ""; b.AutoButtonColor = false
    b.ZIndex = zi or 3; b.Parent = par; return b
end

local function BindClick(btn, fn)
    local last = 0
    local function h()
        local now = os.clock()
        if now - last < 0.25 then return end
        last = now; fn()
    end
    if btn:IsA("TextButton") or btn:IsA("ImageButton") then
        btn.MouseButton1Click:Connect(h)
        pcall(function() btn.TouchTap:Connect(h) end)
    else
        btn.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then h() end
        end)
    end
end

local function MkPress(btn)
    local base = btn.Size
    local function dn()
        Tween(btn,{Size=UDim2.new(base.X.Scale,base.X.Offset-4,base.Y.Scale,base.Y.Offset-4)},.08)
    end
    local function up() Tween(btn,{Size=base},.32,Enum.EasingStyle.Back) end
    btn.MouseButton1Down:Connect(dn); btn.MouseButton1Up:Connect(up); btn.MouseLeave:Connect(up)
    btn.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch then dn() end end)
    btn.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.Touch then up() end end)
end

local function Ripple(button, pos, color)
    if not button or not button.Parent then return end
    if not pos or not pos.X then return end
    pcall(function()
        local r = Frm(button,
            UDim2.fromOffset(8,8),
            UDim2.new(0, pos.X - button.AbsolutePosition.X - 4,
                         0, pos.Y - button.AbsolutePosition.Y - 4),
            color or T.Accent, 20)
        r.BackgroundTransparency = .45; RC(r, 999)
        local ts = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.6
        local cx = pos.X - button.AbsolutePosition.X - ts/2
        local cy = pos.Y - button.AbsolutePosition.Y - ts/2
        Tween(r,{Size=UDim2.fromOffset(ts,ts),Position=UDim2.new(0,cx,0,cy)},.55)
        Tween(r,{BackgroundTransparency=1},.55).Completed:Connect(function() r:Destroy() end)
    end)
end

