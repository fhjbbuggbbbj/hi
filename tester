local pickerH,pickerS,pickerV = Color3.toHSV(Color3.fromRGB(255,80,80))

local function MkColorPicker(parent,yp,onApply)
    local wrap = Frm(parent,UDim2.new(1,-PAD*2,0,0),UDim2.new(0,PAD,0,yp),T.Input,6)
    wrap.ClipsDescendants=true
    local wrapStroke = Stroke(wrap,T.Border,1)
    local innerH = 228

    local SV = Frm(wrap,UDim2.fromOffset(144,114),UDim2.new(0,10,0,10),Color3.fromRGB(255,0,0),7)
    RC(SV,5)
    local WO = Frm(SV,UDim2.new(1,0,1,0),UDim2.new(0,0,0,0),Color3.new(1,1,1),8)
    local wg = Instance.new("UIGradient")
    wg.Transparency=NumberSequence.new({
        NumberSequenceKeypoint.new(0,0),
        NumberSequenceKeypoint.new(1,1),
    })
    wg.Parent=WO
    local BO = Frm(SV,UDim2.new(1,0,1,0),UDim2.new(0,0,0,0),Color3.new(0,0,0),9)
    local bg = Instance.new("UIGradient")
    bg.Rotation=90
    bg.Transparency=NumberSequence.new({
        NumberSequenceKeypoint.new(0,1),
        NumberSequenceKeypoint.new(1,0),
    })
    bg.Parent=BO
    local svCur=Frm(SV,UDim2.fromOffset(13,13),UDim2.new(0,-6,0,-6),Color3.new(1,1,1),10)
    RC(svCur,999); Stroke(svCur,Color3.new(0,0,0),2)

    local Hue=Frm(wrap,UDim2.fromOffset(144,13),UDim2.new(0,10,0,132),Color3.new(1,1,1),7)
    RC(Hue,4)
    local hg=Instance.new("UIGradient")
    hg.Color=ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(255,0,0)),
        ColorSequenceKeypoint.new(1/6, Color3.fromRGB(255,255,0)),
        ColorSequenceKeypoint.new(2/6, Color3.fromRGB(0,255,0)),
        ColorSequenceKeypoint.new(3/6, Color3.fromRGB(0,255,255)),
        ColorSequenceKeypoint.new(4/6, Color3.fromRGB(0,0,255)),
        ColorSequenceKeypoint.new(5/6, Color3.fromRGB(255,0,255)),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(255,0,0)),
    })
    hg.Parent=Hue
    local hueCur=Frm(Hue,UDim2.fromOffset(4,18),UDim2.new(0,-2,0.5,-9),Color3.new(1,1,1),10)
    RC(hueCur,2); Stroke(hueCur,Color3.new(0,0,0),2)

    local cx=162
    local prev=Frm(wrap,UDim2.fromOffset(72,64),UDim2.new(0,cx,0,10),Color3.fromRGB(255,0,0),7)
    RC(prev,9); Stroke(prev,T.Border,1)
    local hexLbl=Lbl(wrap,"#FF5050",UDim2.new(0,72,0,18),UDim2.new(0,cx,0,76),T.Text,FS_S,7,true,Enum.TextXAlignment.Center)
    local applyBtn=Btn(wrap,UDim2.fromOffset(72,28),UDim2.new(0,cx,0,98),T.Accent,8)
    RC(applyBtn,7); MkPress(applyBtn)
    Lbl(applyBtn,"APPLY",UDim2.new(1,0,1,0),UDim2.new(0,0,0,0),T.BG,FS_S,9,true,Enum.TextXAlignment.Center)
    local closeBtn=Btn(wrap,UDim2.fromOffset(72,24),UDim2.new(0,cx,0,130),T.ToggleOff,8)
    RC(closeBtn,7); MkPress(closeBtn)
    Lbl(closeBtn,"CLOSE",UDim2.new(1,0,1,0),UDim2.new(0,0,0,0),T.Text,FS_S,9,true,Enum.TextXAlignment.Center)

    local function rfsh()
        local c=Color3.fromHSV(pickerH,pickerS,pickerV)
        SV.BackgroundColor3=Color3.fromHSV(pickerH,1,1)
        svCur.Position=UDim2.new(pickerS,-6,1-pickerV,-6)
        hueCur.Position=UDim2.new(pickerH,-2,0.5,-9)
        prev.BackgroundColor3=c
        hexLbl.Text=string.format("#%02X%02X%02X",
            math.floor(c.R*255+.5),math.floor(c.G*255+.5),math.floor(c.B*255+.5))
    end

    local svDrag=false
    local function svUpd(pos)
        pickerS=math.clamp((pos.X-SV.AbsolutePosition.X)/SV.AbsoluteSize.X,0,1)
        pickerV=1-math.clamp((pos.Y-SV.AbsolutePosition.Y)/SV.AbsoluteSize.Y,0,1)
        rfsh()
    end
    SV.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then svDrag=true; svUpd(i.Position) end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if svDrag and (i.UserInputType==Enum.UserInputType.MouseMovement
        or i.UserInputType==Enum.UserInputType.Touch) then svUpd(i.Position) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then svDrag=false end
    end)

    local hueDrag=false
    local function hueUpd(pos)
        pickerH=math.clamp((pos.X-Hue.AbsolutePosition.X)/Hue.AbsoluteSize.X,0,1); rfsh()
    end
    Hue.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then hueDrag=true; hueUpd(i.Position) end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if hueDrag and (i.UserInputType==Enum.UserInputType.MouseMovement
        or i.UserInputType==Enum.UserInputType.Touch) then hueUpd(i.Position) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then hueDrag=false end
    end)

    BindClick(applyBtn, function() onApply(Color3.fromHSV(pickerH,pickerS,pickerV)) end)
    RegisterThemed(function()
        wrap.BackgroundColor3=T.Input; wrapStroke.Color=T.Border
        hexLbl.TextColor3=T.Text; applyBtn.BackgroundColor3=T.Accent
        closeBtn.BackgroundColor3=T.ToggleOff
    end)
    rfsh()
    return {
        wrap=wrap, innerH=innerH, closeBtn=closeBtn,
        show=function()
            wrap.Visible=true
            Tween(wrap,{Size=UDim2.new(1,-PAD*2,0,innerH)},.34,Enum.EasingStyle.Back)
        end,
        hide=function()
            Tween(wrap,{Size=UDim2.new(1,-PAD*2,0,0)},.24,Enum.EasingStyle.Quad,Enum.EasingDirection.In)
            Wait(.27); wrap.Visible=false
        end,
    }
end

