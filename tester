local _espAccum   = 0
local _plrCache   = {}
local _cacheTimer = 0
if _G.PerfectESPConn then _G.PerfectESPConn:Disconnect() end
_G.PerfectESPConn = RunService.Heartbeat:Connect(function(dt)
    if not ESP.Enabled then return end
    _espAccum   = _espAccum + dt
    _cacheTimer = _cacheTimer + dt
    if _espAccum < 0.033 then return end
    _espAccum = 0

    if _cacheTimer >= 2 then
        _cacheTimer = 0
        _plrCache   = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then table.insert(_plrCache, p) end
        end
    end

    local lroot = GetPlayerRoot(LocalPlayer)
    if not lroot then return end
    local lpos  = lroot.Position

    for _, p in ipairs(_plrCache) do
        local char = p.Character
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
        if root then
            local dist    = (lpos - root.Position).Magnitude
            local visible = dist <= ESP.MaxDist
            local bb      = _G.PerfectESPBills[p.Name.."_bill"]
            if bb and bb.Parent then
                local lbl = bb:FindFirstChildOfClass("TextLabel")
                if lbl then
                    local txt = ""
                    if ESP.Names then txt = p.Name end
                    if ESP.Distance then
                        txt = txt..(#txt>0 and "\n" or "")..math.floor(dist).."m"
                    end
                    lbl.Text = txt
                    lbl.TextColor3 = ESP.Color
                    bb.Enabled = visible
                end
            end
            local box  = _G.PerfectHighlights[p.Name.."_box"]
            if box  then box.Visible  = visible end
            local cham = _G.PerfectHighlights[p.Name.."_cham"]
            if cham then cham.Enabled = visible end
        end
    end
end)

