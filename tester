local HIGHLIGHT_SUPPORTED = pcall(function()
    local t = Instance.new("Highlight"); t:Destroy()
end)

local function ApplyESP(player)
    if player == LocalPlayer then return end
    local char = player.Character; if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if not root then return end

    local boxKey = player.Name.."_box"
    if ESP.Boxes then
        local h = _G.PerfectHighlights[boxKey]
        if not h then
            h = Instance.new("SelectionBox")
            h.Name = "PerfectESP_Box"; h.LineThickness = 0.07
            h.Color3 = ESP.Color; h.SurfaceTransparency = 1
            h.SurfaceColor3 = ESP.Color; h.Adornee = char; h.Parent = char
            _G.PerfectHighlights[boxKey] = h
        else
            h.Color3=ESP.Color; h.SurfaceColor3=ESP.Color; h.Adornee=char
        end
    else
        if _G.PerfectHighlights[boxKey] then
            pcall(function() _G.PerfectHighlights[boxKey]:Destroy() end)
            _G.PerfectHighlights[boxKey]=nil
        end
    end

    local chamKey = player.Name.."_cham"
    if ESP.Chams and HIGHLIGHT_SUPPORTED then
        local hl = _G.PerfectHighlights[chamKey]
        if not hl then
            local ok = pcall(function()
                hl = Instance.new("Highlight")
                hl.Name = "PerfectESP_Chams"
                hl.FillColor = ESP.Color; hl.FillTransparency = .52
                hl.OutlineColor = ESP.Color; hl.OutlineTransparency = 0
                pcall(function() hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop end)
                hl.Adornee = char; hl.Parent = char
            end)
            if ok then _G.PerfectHighlights[chamKey] = hl end
        else
            pcall(function()
                hl.FillColor=ESP.Color; hl.OutlineColor=ESP.Color; hl.Adornee=char
            end)
        end
    else
        if _G.PerfectHighlights[chamKey] then
            pcall(function() _G.PerfectHighlights[chamKey]:Destroy() end)
            _G.PerfectHighlights[chamKey]=nil
        end
    end

    local billKey = player.Name.."_bill"
    if ESP.Names or ESP.Distance then
        if _G.PerfectESPBills[billKey] then
            pcall(function() _G.PerfectESPBills[billKey]:Destroy() end)
        end
        _G.PerfectESPBills[billKey] = MakeBillboard(root,"",ESP.Color)
    else
        if _G.PerfectESPBills[billKey] then
            pcall(function() _G.PerfectESPBills[billKey]:Destroy() end)
            _G.PerfectESPBills[billKey]=nil
        end
    end
end

local OIL_KW = {"oilrig","oil_rig","oil-rig","oil rig","oilplatform","oil_platform","oil platform"}
local function ApplyOilRigESP()
    local found = {}
    local function search(parent, depth)
        if depth>5 then return end
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("Model") then
                local n = obj.Name:lower()
                for _, kw in ipairs(OIL_KW) do
                    if n:find(kw,1,true) then table.insert(found,obj); break end
                end
                search(obj, depth+1)
            elseif obj:IsA("Folder") then search(obj,depth+1) end
        end
    end
    search(Workspace,0)
    for _, rig in ipairs(found) do
        local part = rig.PrimaryPart or rig:FindFirstChildWhichIsA("BasePart")
        if part then
            local key = "OilRig_"..rig:GetFullName()
            if not _G.PerfectHighlights[key] then
                local h = Instance.new("SelectionBox")
                h.Name="PerfectESP_OilRig"; h.LineThickness=0.09
                h.Color3=Color3.fromRGB(255,200,0); h.SurfaceTransparency=0.82
                h.SurfaceColor3=Color3.fromRGB(255,200,0); h.Adornee=rig; h.Parent=rig
                _G.PerfectHighlights[key]=h
            end
