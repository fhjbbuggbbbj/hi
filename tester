local function MkColorDropdown(par, yp, getColor, setColor)
    local DD_H     = 36
    local MAX_ROWS = 6
    local RH       = 28
    local listH    = math.min(#COLOR_PRESETS, MAX_ROWS)*(RH+2)+10

    local container = Frm(par, UDim2.new(1,-PAD*2,0,DD_H), UDim2.new(0,PAD,0,yp), T.BG, 6)
    container.BackgroundTransparency = 1
    container.ClipsDescendants       = false

    local header = Btn(container, UDim2.new(1,0,0,DD_H), UDim2.new(0,0,0,0), T.Input, 7)
    RC(header,9); MkPress(header)
    local headerStroke = Stroke(header, T.Border, 1)
    local swatch = Frm(header, UDim2.fromOffset(20,20), UDim2.new(0,10,0.5,-10), getColor(), 8)
    RC(swatch,6); Stroke(swatch, Color3.new(0,0,0), 1)
    local nameLbl = Lbl(header,"Crimson",UDim2.new(1,-72,1,0),UDim2.new(0,38,0,0),T.Text,FS,8,true)
    local chevron = Lbl(header,"▾",UDim2.new(0,20,1,0),UDim2.new(1,-27,0,0),T.TextDim,15,8,false,Enum.TextXAlignment.Center)

    local list = Frm(container, UDim2.new(1,0,0,0), UDim2.new(0,0,0,DD_H+5), T.Panel, 9)
    RC(list,9); local listStroke = Stroke(list,T.Border,1)
    list.ClipsDescendants=true; list.Visible=false
    list.BackgroundTransparency=1; listStroke.Transparency=1

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size                 = UDim2.new(1,-6,1,-6)
    scroll.Position             = UDim2.new(0,3,0,3)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel      = 0
    scroll.ScrollBarThickness   = 3
    scroll.ScrollBarImageColor3 = T.Accent
    scroll.CanvasSize           = UDim2.new(0,0,0,#COLOR_PRESETS*(RH+2))
    scroll.ZIndex               = 10
    scroll.Parent               = list

    local rows = {}
    for i, cp in ipairs(COLOR_PRESETS) do
        local row = Frm(scroll, UDim2.new(1,0,0,RH), UDim2.new(0,0,0,(i-1)*(RH+2)), T.BG, 10)
        row.BackgroundTransparency = 1
        local d = Frm(row,UDim2.fromOffset(16,16),UDim2.new(0,6,0.5,-8),cp.c,11)
        RC(d,999); Stroke(d,Color3.new(0,0,0),1)
        Lbl(row,cp.n,UDim2.new(1,-32,1,0),UDim2.new(0,28,0,0),T.Text,FS,11)
        local sel = Frm(row,UDim2.fromOffset(8,8),UDim2.new(1,-16,0.5,-4),
            getColor()==cp.c and T.Accent or T.ToggleOff,11)
        RC(sel,999)
        table.insert(rows,{row=row,sel=sel,c=cp.c,name=cp.n})
        row.MouseEnter:Connect(function() Tween(row,{BackgroundTransparency=.82},.1) end)
        row.MouseLeave:Connect(function() Tween(row,{BackgroundTransparency=1},.1)   end)
        BindClick(row, function()
            setColor(cp.c)
            swatch.BackgroundColor3 = cp.c
            nameLbl.Text = cp.n
            for _, rr in ipairs(rows) do
                rr.sel.BackgroundColor3 = (rr.c==cp.c) and T.Accent or T.ToggleOff
            end
            Ripple(row, Vector2.new(row.AbsolutePosition.X+30, row.AbsolutePosition.Y+RH/2), cp.c)
        end)
    end

    local open = false
    local function setOpen(o)
        if open==o then return end; open=o
        if o then
            list.Visible=true; list.Size=UDim2.new(1,0,0,0)
            list.BackgroundTransparency=1; listStroke.Transparency=1
            Tween(list,{Size=UDim2.new(1,0,0,listH),BackgroundTransparency=0},.3,Enum.EasingStyle.Back)
            Tween(listStroke,{Transparency=0},.3)
            Tween(chevron,{Rotation=180},.28,Enum.EasingStyle.Back)
        else
            Tween(list,{Size=UDim2.new(1,0,0,0),BackgroundTransparency=1},.22,Enum.EasingStyle.Quad,Enum.EasingDirection.In)
            Tween(listStroke,{Transparency=1},.22)
            Tween(chevron,{Rotation=0},.22)
            Wait(.24); if not open then list.Visible=false end
        end
    end
    BindClick(header, function()
        setOpen(not open)
        Ripple(header, UserInputService:GetMouseLocation(), T.Accent)
    end)
    RegisterThemed(function()
        header.BackgroundColor3=T.Input; headerStroke.Color=T.Border
        list.BackgroundColor3=T.Panel;   listStroke.Color=T.Border
        for _, rr in ipairs(rows) do rr.sel.BackgroundColor3=(rr.c==getColor()) and T.Accent or T.ToggleOff end
    end)
    return {
        container=container,
        refresh=function()
            swatch.BackgroundColor3=getColor()
            for _, rr in ipairs(rows) do
                if rr.c==getColor() then nameLbl.Text=rr.name end
                rr.sel.BackgroundColor3=(rr.c==getColor()) and T.Accent or T.ToggleOff
            end
        end,
    }
end

