        end)
        thumb.ScaleType=Enum.ScaleType.Fit; thumb.ZIndex=104; thumb.Parent=fig

        local cham = Frm(fig,UDim2.new(1,8,1,8),UDim2.new(0,-4,0,-4),ESP.Color,105)
