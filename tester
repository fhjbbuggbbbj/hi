-- ── TAB SWITCHER ───────────────────────────────────────────────────────────
local tabMap = {
    Visuals   = {frame=VisFrame, entry=VisEntry},
    World     = {frame=WldFrame, entry=WldEntry},
    ESP       = {frame=EspFrame, entry=EspEntry},
    Inventory = {frame=InvFrame, entry=InvEntry},
    Configs   = {frame=CfgFrame, entry=CfgEntry},
}

local function SwitchTab(name)
    for n, data in pairs(tabMap) do
        local active = (n==name)
        if active ~= data.frame.Visible then
            data.frame.Visible = active
            if active then
                data.frame.Position=UDim2.new(0,12,0,TAB_Y)
                Tween(data.frame,{Position=UDim2.new(0,0,0,TAB_Y)},.3,Enum.EasingStyle.Quint)
            end
        end
        Tween(data.entry.btn,{BackgroundColor3=active and T.SelSide or T.Sidebar},.16)
        data.entry.lbl.TextColor3  = active and T.Accent or T.Text
        data.entry.icon.TextColor3 = active and T.Accent or T.TextDim
        data.entry.accent.BackgroundTransparency = active and 0 or 1
    end
    currentTab = name
    local entry = tabMap[name] and tabMap[name].entry
    if entry then
        Indicator.BackgroundTransparency=0
        Tween(Indicator,{Position=UDim2.new(0,0,0,entry.y),Size=UDim2.new(0,3,0,SIDE_TAB_H)},.3,Enum.EasingStyle.Quint)
    end
    if name~="ESP" and previewOpen then HidePreview() end
end

for name, data in pairs(tabMap) do
    BindClick(data.entry.btn, function()
        SwitchTab(name)
        Ripple(data.entry.btn,UserInputService:GetMouseLocation(),T.Accent)
    end)
    data.entry.btn.MouseEnter:Connect(function()
        if currentTab~=name then Tween(data.entry.btn,{BackgroundColor3=T.SelSide:Lerp(T.BG,.35)},.14) end
    end)
    data.entry.btn.MouseLeave:Connect(function()
        if currentTab~=name then Tween(data.entry.btn,{BackgroundColor3=T.Sidebar},.14) end
    end)
end

